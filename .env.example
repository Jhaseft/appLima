# ============================================================
# TRANSFERCASH — Ejemplo de variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# ============================================================

# Backend
EXPO_PUBLIC_API_BASE_URL=https://tu-backend.com

# Google OAuth (react-native-google-signin)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Cloudinary (imágenes públicas — cloud names)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME_MAIN=tu_cloud_name
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME_HOME=tu_cloud_name_home

# KYC — deep link de retorno tras verificación
EXPO_PUBLIC_KYC_DEEP_LINK=transfercash://kyc-resultado?status=approved

# EAS / Expo
EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
